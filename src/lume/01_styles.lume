/// ─── CHRONOVERSE FAMILY PORTAL DESIGN SYSTEM ────────────────────────────

dom.inject_css(`
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    
    :root {
      --bg: #0a0a14;
      --bg-card: rgba(18, 18, 35, 0.9);
      --bg-elevated: rgba(25, 25, 50, 0.95);
      --border: rgba(255,255,255,0.06);
      --border-hover: rgba(255,255,255,0.12);
      --text: #e2e8f0;
      --text-dim: #64748b;
      --text-bright: #ffffff;
      --accent: #22d3ee;
      --accent-glow: rgba(34,211,238,0.15);
      --accent-solid: rgba(34,211,238,0.2);
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #f43f5e;
      --purple: #a855f7;
      --radius: 16px;
      --radius-sm: 10px;
    }

    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* ── Animated Background ── */
    body::before {
      content: '';
      position: fixed; inset: 0; z-index: -1;
      background: 
        radial-gradient(ellipse at 20% 0%, rgba(34,211,238,0.08) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 100%, rgba(168,85,247,0.06) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 50%, rgba(16,185,129,0.04) 0%, transparent 60%);
    }

    /* ── Auth Screen ── */
    .auth-screen {
      min-height: 100vh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 24px;
    }
    .auth-logo {
      font-size: 48px; margin-bottom: 8px;
    }
    .auth-title {
      font-size: 32px; font-weight: 900; color: var(--text-bright);
      margin-bottom: 4px; letter-spacing: -0.5px;
    }
    .auth-subtitle {
      font-size: 14px; color: var(--text-dim); margin-bottom: 40px;
      font-weight: 500;
    }
    .auth-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px 28px;
      width: 100%; max-width: 400px;
      backdrop-filter: blur(20px);
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    .auth-tabs {
      display: flex; gap: 0; margin-bottom: 28px;
      background: rgba(255,255,255,0.04);
      border-radius: var(--radius-sm); padding: 4px;
    }
    .auth-tab {
      flex: 1; padding: 10px; border: none;
      background: transparent; color: var(--text-dim);
      font-size: 14px; font-weight: 700; cursor: pointer;
      border-radius: 8px; transition: all 0.2s;
    }
    .auth-tab.active {
      background: var(--accent-solid);
      color: var(--accent);
    }
    .form-group {
      margin-bottom: 18px;
    }
    .form-group label {
      display: block; font-size: 12px; font-weight: 700;
      color: var(--text-dim); text-transform: uppercase;
      letter-spacing: 0.5px; margin-bottom: 8px;
    }
    .form-input {
      width: 100%; background: rgba(255,255,255,0.04);
      border: 1px solid var(--border); border-radius: var(--radius-sm);
      color: var(--text-bright); font-size: 16px; padding: 14px 16px;
      font-family: 'Inter', sans-serif; font-weight: 500;
      outline: none; transition: border-color 0.2s;
    }
    .form-input:focus { border-color: var(--accent); }
    .form-input::placeholder { color: var(--text-dim); }
    .auth-btn {
      width: 100%; padding: 16px; border: none;
      background: linear-gradient(135deg, var(--accent), #6366f1);
      color: #fff; font-size: 16px; font-weight: 800;
      border-radius: var(--radius-sm); cursor: pointer;
      transition: all 0.2s; letter-spacing: 0.5px;
      margin-top: 8px;
    }
    .auth-btn:active { transform: scale(0.97); }
    .auth-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .auth-error {
      background: rgba(244,63,94,0.1); border: 1px solid rgba(244,63,94,0.2);
      color: var(--danger); padding: 10px 14px; border-radius: var(--radius-sm);
      font-size: 13px; font-weight: 600; margin-bottom: 16px; display: none;
    }
    .auth-divider {
      text-align: center; color: var(--text-dim); font-size: 12px;
      font-weight: 600; margin: 20px 0; position: relative;
    }
    .auth-divider::before, .auth-divider::after {
      content: ''; position: absolute; top: 50%;
      width: 40%; height: 1px; background: var(--border);
    }
    .auth-divider::before { left: 0; }
    .auth-divider::after { right: 0; }
    .auth-google {
      width: 100%; padding: 14px; border: 1px solid var(--border);
      background: rgba(255,255,255,0.04); color: var(--text);
      font-size: 14px; font-weight: 700; border-radius: var(--radius-sm);
      cursor: pointer; transition: all 0.2s;
      display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .auth-google:hover { border-color: var(--border-hover); background: rgba(255,255,255,0.06); }

    /* ── Dashboard Shell ── */
    .dashboard { display: none; min-height: 100vh; }
    .dashboard.active { display: block; }
    .auth-screen.hidden { display: none; }

    /* Top Bar */
    .topbar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(10px);
      position: sticky; top: 0; z-index: 100;
      background: rgba(10,10,20,0.8);
    }
    .topbar-brand {
      display: flex; align-items: center; gap: 10px;
    }
    .topbar-brand span:first-child { font-size: 24px; }
    .topbar-brand span:last-child {
      font-size: 16px; font-weight: 800; color: var(--text-bright);
      letter-spacing: -0.3px;
    }
    .topbar-user {
      display: flex; align-items: center; gap: 10px;
    }
    .topbar-user-name {
      font-size: 13px; font-weight: 600; color: var(--text-dim);
    }
    .topbar-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--accent-solid); border: 2px solid var(--accent);
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; font-weight: 800; color: var(--accent);
      cursor: pointer;
    }
    .signout-btn {
      background: rgba(244,63,94,0.1); border: 1px solid rgba(244,63,94,0.2);
      color: var(--danger); padding: 8px 16px; border-radius: 8px;
      font-size: 12px; font-weight: 700; cursor: pointer;
    }

    /* Main Content */
    .main-content {
      max-width: 800px; margin: 0 auto;
      padding: 24px 20px 100px;
    }

    /* Welcome Section */
    .welcome-section {
      margin-bottom: 32px;
    }
    .welcome-section h1 {
      font-size: 28px; font-weight: 900; color: var(--text-bright);
      letter-spacing: -0.5px; margin-bottom: 4px;
    }
    .welcome-section p {
      font-size: 14px; color: var(--text-dim); font-weight: 500;
    }

    /* Stats Row */
    .stats-row {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 12px; margin-bottom: 32px;
    }
    .stat-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 18px 16px; text-align: center;
    }
    .stat-card .stat-value {
      font-size: 28px; font-weight: 900; color: var(--text-bright);
      margin-bottom: 2px;
    }
    .stat-card .stat-label {
      font-size: 11px; color: var(--text-dim); font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.5px;
    }

    /* Section Headers */
    .section-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 16px;
    }
    .section-header h2 {
      font-size: 18px; font-weight: 800; color: var(--text-bright);
    }
    .section-header button {
      background: var(--accent-solid); border: 1px solid rgba(34,211,238,0.2);
      color: var(--accent); padding: 10px 20px; border-radius: 50px;
      font-size: 13px; font-weight: 800; cursor: pointer;
      transition: all 0.2s;
    }
    .section-header button:active { transform: scale(0.95); }

    /* Kid Cards */
    .kid-cards { display: flex; flex-direction: column; gap: 14px; }
    .kid-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 20px;
      display: flex; align-items: center; gap: 16px;
      cursor: pointer; transition: all 0.2s;
    }
    .kid-card:active { transform: scale(0.98); }
    .kid-card:hover { border-color: var(--border-hover); }
    .kid-card-avatar {
      width: 56px; height: 56px; border-radius: 50%;
      object-fit: cover; border: 3px solid var(--accent);
      background: #0a0a2e; flex-shrink: 0;
    }
    .kid-card-info { flex: 1; min-width: 0; }
    .kid-card-name {
      font-size: 17px; font-weight: 800; color: var(--text-bright);
      margin-bottom: 2px;
    }
    .kid-card-username {
      font-size: 12px; color: var(--accent); font-weight: 600;
      margin-bottom: 6px;
    }
    .kid-card-stats {
      display: flex; gap: 12px;
    }
    .kid-card-stat {
      font-size: 11px; color: var(--text-dim); font-weight: 600;
      display: flex; align-items: center; gap: 4px;
    }
    .kid-card-stat .dot {
      width: 8px; height: 8px; border-radius: 50%;
    }
    .kid-card-actions {
      display: flex; flex-direction: column; gap: 6px; flex-shrink: 0;
    }
    .kid-action-btn {
      padding: 8px 14px; border-radius: 8px; border: none;
      font-size: 12px; font-weight: 800; cursor: pointer; transition: all 0.2s;
      white-space: nowrap;
    }
    .kid-action-btn.play {
      background: linear-gradient(135deg, var(--success), #059669);
      color: #fff;
    }
    .kid-action-btn.view {
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--border); color: var(--text-dim);
    }

    /* Empty State */
    .empty-state {
      text-align: center; padding: 60px 20px;
      background: var(--bg-card); border: 2px dashed var(--border);
      border-radius: var(--radius);
    }
    .empty-state .empty-icon { font-size: 64px; margin-bottom: 16px; }
    .empty-state h3 { font-size: 20px; font-weight: 800; color: var(--text-bright); margin-bottom: 8px; }
    .empty-state p { font-size: 14px; color: var(--text-dim); margin-bottom: 24px; line-height: 1.6; }
    .empty-state button {
      background: linear-gradient(135deg, var(--accent), #6366f1);
      border: none; color: #fff; padding: 14px 32px; border-radius: 50px;
      font-size: 15px; font-weight: 800; cursor: pointer;
    }

    /* Add Kid Modal */
    .modal-overlay {
      position: fixed; inset: 0; z-index: 9000;
      background: rgba(0,0,0,0.7); backdrop-filter: blur(6px);
      display: none; align-items: flex-end; justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    @media (min-width: 600px) {
      .modal-overlay.open { align-items: center; }
    }
    .modal-content {
      background: var(--bg-elevated); border: 1px solid var(--border);
      border-radius: var(--radius) var(--radius) 0 0;
      padding: 28px 24px 40px; width: 100%; max-width: 440px;
      animation: modalSlideUp 0.3s ease;
    }
    @media (min-width: 600px) {
      .modal-content { border-radius: var(--radius); }
    }
    @keyframes modalSlideUp { from { transform: translateY(30px); opacity: 0; } }
    .modal-content h3 {
      font-size: 20px; font-weight: 900; color: var(--text-bright);
      margin-bottom: 20px;
    }
    .modal-close {
      position: absolute; top: 16px; right: 16px;
      background: none; border: none; color: var(--text-dim);
      font-size: 24px; cursor: pointer;
    }
    .username-preview {
      background: rgba(34,211,238,0.06); border: 1px solid rgba(34,211,238,0.15);
      border-radius: var(--radius-sm); padding: 12px 16px;
      margin-bottom: 18px; display: flex; align-items: center; gap: 6px;
    }
    .username-preview .url-prefix {
      font-size: 13px; color: var(--text-dim); font-weight: 600;
    }
    .username-preview .url-name {
      font-size: 13px; color: var(--accent); font-weight: 800;
    }
    .username-preview .url-suffix {
      font-size: 13px; color: var(--text-dim); font-weight: 600;
    }
    .username-status {
      font-size: 12px; font-weight: 700; margin-top: 6px; height: 16px;
    }
    .username-status.available { color: var(--success); }
    .username-status.taken { color: var(--danger); }

    /* Activity Feed */
    .activity-section { margin-top: 32px; }
    .activity-item {
      display: flex; align-items: center; gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
    }
    .activity-icon {
      width: 36px; height: 36px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; flex-shrink: 0;
    }
    .activity-text {
      font-size: 13px; color: var(--text); font-weight: 500; flex: 1;
    }
    .activity-text strong { color: var(--text-bright); font-weight: 700; }
    .activity-time {
      font-size: 11px; color: var(--text-dim); font-weight: 600; flex-shrink: 0;
    }

    /* ── Footer ── */
    .footer {
      text-align: center; padding: 40px 20px 30px;
      border-top: 1px solid var(--border); margin-top: 40px;
    }
    .footer p { font-size: 12px; color: var(--text-dim); font-weight: 500; line-height: 2; }
    .footer .lume { color: var(--accent); font-weight: 700; }
`, "family-portal-styles")
