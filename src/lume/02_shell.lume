/// ─── CHRONOVERSE FAMILY PORTAL APP SHELL ────────────────────────────────
/// Deterministic DOM construction via Lume dom primitives

function buildShell() {
  define root = dom.create('div', { id: 'family-portal-root' })
  root.innerHTML = `<!-- ═══════════════════════════════════ -->
  <!--        AUTH SCREEN                  -->
  <!-- ═══════════════════════════════════ -->
  <div id="auth-screen" class="auth-screen">
    <div class="auth-logo">🌀</div>
    <div class="auth-title">Chronoverse Family</div>
    <div class="auth-subtitle">Parent Dashboard • Manage & Play Together</div>
    
    <div class="auth-card">
      <div class="auth-tabs">
        <button class="auth-tab active" onclick="switchAuthTab('login')">Log In</button>
        <button class="auth-tab" onclick="switchAuthTab('signup')">Sign Up</button>
      </div>

      <div id="auth-error" class="auth-error"></div>

      <div id="login-form">
        <div class="form-group">
          <label>Email</label>
          <input type="email" class="form-input" id="login-email" placeholder="parent@email.com" />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" class="form-input" id="login-password" placeholder="••••••••" />
        </div>
        <button class="auth-btn" onclick="handleLogin()">Log In</button>
      </div>

      <div id="signup-form" style="display:none;">
        <div class="form-group">
          <label>Your Name</label>
          <input type="text" class="form-input" id="signup-name" placeholder="Your name" />
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" class="form-input" id="signup-email" placeholder="parent@email.com" />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" class="form-input" id="signup-password" placeholder="Min 6 characters" />
        </div>
        <button class="auth-btn" onclick="handleSignup()">Create Account</button>
      </div>

      <div class="auth-divider">or</div>
      <button class="auth-google" onclick="handleGoogleAuth()">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
        Continue with Google
      </button>
    </div>
    
    <div style="margin-top:24px; font-size:12px; color:var(--text-dim); text-align:center;">
      Made with <span style="color:var(--accent); font-weight:700;">Lume</span> • DarkWave Studios
    </div>
  </div>

  <!-- ═══════════════════════════════════ -->
  <!--        DASHBOARD                    -->
  <!-- ═══════════════════════════════════ -->
  <div id="dashboard" class="dashboard">
    
    <!-- Top Bar -->
    <div class="topbar">
      <div class="topbar-brand">
        <span>🌀</span>
        <span>Chronoverse Family</span>
      </div>
      <div class="topbar-user">
        <span class="topbar-user-name" id="topbar-name"></span>
        <button class="signout-btn" onclick="handleSignOut()">Sign Out</button>
      </div>
    </div>

    <div class="main-content">
      
      <!-- Welcome -->
      <div class="welcome-section">
        <h1 id="welcome-heading">Welcome back!</h1>
        <p>Here's what's happening in your kids' Chronoverse</p>
      </div>

      <!-- Stats Overview -->
      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-value" id="stat-kids">0</div>
          <div class="stat-label">Kids</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" id="stat-levels">0</div>
          <div class="stat-label">Levels Beat</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" id="stat-stars">0</div>
          <div class="stat-label">Stars Earned</div>
        </div>
      </div>

      <!-- Kid Profiles -->
      <div class="section-header">
        <h2>Your Kids</h2>
        <button onclick="openAddKidModal()">+ Add Kid</button>
      </div>
      <div class="kid-cards" id="kid-cards">
        <!-- Populated by JS -->
        <div class="empty-state" id="empty-state">
          <div class="empty-icon">👶</div>
          <h3>No kids yet!</h3>
          <p>Add your child's profile to get started. They'll get their own personalized portal at <strong>username.tlid.io</strong></p>
          <button onclick="openAddKidModal()">+ Add First Kid</button>
        </div>
      </div>
      <!-- Friend Management (Parent-Approved) -->
      <div class="activity-section" id="friends-management" style="display:none;">
        <div class="section-header">
          <h2>👥 Friend Requests</h2>
        </div>
        <p style="font-size:13px; color:var(--text-dim); margin-bottom:16px; font-weight:500;">Your approval is required before your kids can connect with friends. This keeps them safe.</p>
        <div id="parent-friend-requests" style="display:flex; flex-direction:column; gap:10px;">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Activity Feed -->
      <div class="activity-section">
        <div class="section-header">
          <h2>Recent Activity</h2>
        </div>
        <div id="activity-feed">
          <div class="activity-item">
            <div class="activity-icon" style="background:var(--accent-solid);">🎮</div>
            <div class="activity-text">Activity will appear here once your kids start playing</div>
            <div class="activity-time">—</div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="footer">
        <div style="display:flex; gap:12px; justify-content:center; margin-bottom:20px; flex-wrap:wrap;">
          <a href="https://chronoverse.tlid.io" style="text-decoration:none; background:var(--accent-solid); border:1px solid rgba(34,211,238,0.2); border-radius:12px; padding:10px 20px; display:flex; align-items:center; gap:8px;">
            <span style="font-size:18px;">🌀</span>
            <span style="color:var(--accent); font-size:13px; font-weight:800;">Main Hub</span>
          </a>
          <a href="https://darkwave.tlid.io" style="text-decoration:none; background:rgba(168,85,247,0.1); border:1px solid rgba(168,85,247,0.2); border-radius:12px; padding:10px 20px; display:flex; align-items:center; gap:8px;">
            <span style="font-size:18px;">🌊</span>
            <span style="color:var(--purple); font-size:13px; font-weight:800;">DarkWave Studios</span>
          </a>
        </div>
        <p>Made with ❤️ in Gladeville, TN, USA 🇺🇸</p>
        <p>Made with <span class="lume">Lume</span> • DarkWave Studios</p>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════ -->
  <!--        ADD KID MODAL               -->
  <!-- ═══════════════════════════════════ -->
  <div id="add-kid-modal" class="modal-overlay" onclick="if(event.target===this)closeAddKidModal()">
    <div class="modal-content" style="position:relative;">
      <button class="modal-close" onclick="closeAddKidModal()">✕</button>
      <h3>Add a Kid</h3>

      <div class="form-group">
        <label>Kid's Name</label>
        <input type="text" class="form-input" id="kid-name" placeholder="What's their name?" oninput="generateUsername()" />
      </div>

      <div class="form-group">
        <label>Username (their portal URL)</label>
        <input type="text" class="form-input" id="kid-username" placeholder="Choose a unique username" oninput="checkUsername()" maxlength="20" />
        <div class="username-status" id="username-status"></div>
      </div>

      <div class="username-preview">
        <span class="url-prefix">https://</span>
        <span class="url-name" id="username-preview-name">username</span>
        <span class="url-suffix">.tlid.io</span>
      </div>

      <div id="add-kid-error" class="auth-error"></div>

      <button class="auth-btn" id="add-kid-btn" onclick="handleAddKid()" disabled>Create Portal</button>
    </div>
  </div>

  <!-- ═══════════════════════════════════ -->
  <!--        JAVASCRIPT ENGINE           -->
  <!-- ═══════════════════════════════════ -->`
  dom.mount(root)
}
